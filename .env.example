# ============================
# mrsmartservice API (Nest + TS)
# ============================

# Puerto del API
PORT=8080

# URL del front (para back_urls de MercadoPago, links de factura/reset, etc.)
FRONT_URL=http://localhost:3000

# ============================
# Postgres
# Usa SOLO UNA de estas opciones:
# ============================

# Opción A (recomendada): DATABASE_URL
# Ejemplo local:
# DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/mrsmartservice
DATABASE_URL=postgresql://mrsmartservice_db_user:az4PBm22GCMmLn2XyNolPFiVTCIfNgYe@dpg-d4k8q02dbo4c73cquo40-a.oregon-postgres.render.com/mrsmartservice_db

# Opción B: variables separadas (compat con .env antiguos)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Puedes usar DB_PASS o DB_PASSWORD (el código soporta ambos)
DB_PASS=admin
DB_PASSWORD=admin
DB_NAME=mrsmartservice

# ============================
# Auth
# ============================
JWT_SECRET=un_secreto_largo_raro_123

# ============================
# Mercado Pago
# ============================
MP_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY
MP_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN

# Si NO tienes credenciales de MP en local, puedes activar mock (dev only):
# MP_MOCK=1

# (Opcional) URL pública del API (si estás detrás de proxy) para notification_url
PUBLIC_API_URL=http://localhost:8080

# ============================
# Uploads
# ============================
# Si NO configuras GCS, el backend usa fallback local ./uploads
GCS_BUCKET=mrsmartservice-media
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_UPLOAD_FOLDER=mrsmartservice
# ============================
# SMTP (opcional) - para enviar correo de reset
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password_or_app_password

