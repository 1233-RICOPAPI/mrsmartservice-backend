generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId         Int             @id @default(autoincrement()) @map("user_id")
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           String          @default("USER")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  passwordResets PasswordReset[]
  productReviews ProductReview[]

  @@map("users")
}

model Product {
  productId           Int             @id @default(autoincrement()) @map("product_id")
  name                String
  price               Decimal         @default(0) @db.Decimal(12, 2)
  stock               Int             @default(0)
  discountPercent     Int             @default(0) @map("discount_percent")
  imageUrl            String?         @map("image_url")
  category            String?
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamp(6)
  discount_expires_at DateTime?       @db.Timestamp(6)
  videoUrl            String?         @map("video_url")
  discountStart       DateTime?       @map("discount_start") @db.Timestamp(6)
  discountEnd         DateTime?       @map("discount_end") @db.Timestamp(6)
  specs               String?
  techSheet           String?         @map("tech_sheet")
  description         String?
  items               OrderItem[]
  reviews             ProductReview[]

  @@index([active, category], map: "idx_products_active_category")
  @@map("products")
}

model ProductReview {
  reviewId   Int      @id @default(autoincrement()) @map("review_id")
  productId  Int      @map("product_id")
  authorName String   @map("author_name")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  userId     Int?     @map("user_id")
  visitorKey String?  @map("visitor_key")
  product    Product  @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction)
  user       User?    @relation(fields: [userId], references: [userId], onUpdate: NoAction)

  @@map("product_reviews")
}

model Ad {
  adId        Int       @id @default(autoincrement()) @map("ad_id")
  title       String
  description String?
  videoUrl    String?   @map("video_url")
  imageUrl    String?   @map("image_url")
  active      Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  linkUrl     String?   @map("link_url")

  @@index([active], map: "idx_ads_active")
  @@index([active, createdAt(sort: Desc)], map: "idx_ads_active_created_at")
  @@map("ads")
}

model Software {
  softwareId              Int                  @id @default(autoincrement()) @map("software_id")
  name                    String
  shortDescription        String?              @map("short_description")
  features                String?
  tags                    String?
  price                   Decimal?             @db.Decimal(12, 2)
  imageUrl                String?              @map("image_url")
  whatsapp_template       String?
  active                  Boolean              @default(true)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  whatsappMessageTemplate String?              @map("whatsapp_message_template")
  licenses                License[]
  credentials             SoftwareCredential[]

  @@map("softwares")
}

model SoftwareCredential {
  credentialId Int      @id @default(autoincrement()) @map("credential_id")
  softwareId   Int      @map("software_id")
  orderId      Int?     @map("order_id")
  username     String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  order        Order?   @relation(fields: [orderId], references: [orderId], onUpdate: NoAction)
  software     Software @relation(fields: [softwareId], references: [softwareId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([softwareId, username], map: "software_credentials_software_username_key")
  @@index([softwareId])
  @@index([orderId])
  @@map("software_credentials")
}

model License {
  licenseId       Int                 @id @default(autoincrement()) @map("license_id")
  softwareId      Int                 @map("software_id")
  customerEmail   String?             @map("customer_email")
  customerName    String?             @map("customer_name")
  customerNit     String?             @map("customer_nit")
  customerCompany String?             @map("customer_company")
  licenseType     String              @default("PERPETUAL") @map("license_type")
  majorMax        Int                 @default(1) @map("major_max")
  maxSites        Int                 @default(3) @map("max_sites")
  maxDevices      Int                 @default(6) @map("max_devices")
  expiresAt       DateTime?           @map("expires_at") @db.Timestamp(6)
  revoked         Boolean             @default(false)
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamp(6)
  notes           String?
  licenseKey      String              @unique @map("license_key")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)
  activations     LicenseActivation[]
  software        Software            @relation(fields: [softwareId], references: [softwareId], onUpdate: NoAction)

  @@index([softwareId])
  @@map("licenses")
}

model LicenseActivation {
  activationId  Int       @id @default(autoincrement()) @map("activation_id")
  licenseId     Int       @map("license_id")
  machineId     String    @map("machine_id")
  siteCode      String?   @map("site_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamp(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamp(6)
  license       License   @relation(fields: [licenseId], references: [licenseId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([licenseId, machineId])
  @@unique([licenseId, machineId], map: "license_activations_license_machine_key")
  @@index([machineId])
  @@map("license_activations")
}

model Order {
  orderId             Int                  @id @default(autoincrement()) @map("order_id")
  status              String               @default("pending")
  totalAmount         Decimal              @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentId           String?              @map("payment_id")
  payerEmail          String?              @map("payer_email")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  shipping_type       String?
  shipping_cost       Decimal?             @default(0) @db.Decimal(10, 2)
  shipping_name       String?
  shipping_phone      String?
  shipping_address    String?
  shipping_notes      String?
  domicilioModo       String?              @map("domicilio_modo")
  domicilioNombre     String?              @map("domicilio_nombre")
  domicilioDireccion  String?              @map("domicilio_direccion")
  domicilioBarrio     String?              @map("domicilio_barrio")
  domicilioCiudad     String?              @map("domicilio_ciudad")
  domicilioTelefono   String?              @map("domicilio_telefono")
  domicilioNota       String?              @map("domicilio_nota")
  fechaDomicilio      DateTime?            @map("fecha_domicilio") @db.Timestamp(6)
  estadoDomicilio     String?              @map("estado_domicilio")
  carrier_mode        String?
  domicilioCosto      Decimal              @default(0) @map("domicilio_costo") @db.Decimal(12, 2)
  customer_name       String?
  customer_email      String?
  customer_phone      String?
  customer_city       String?
  customer_address    String?
  paymentStatus       String?              @map("payment_status")
  approved_at         DateTime?            @db.Timestamptz(6)
  buyerName           String?              @map("buyer_name")
  buyerEmail          String?              @map("buyer_email")
  buyerPhone          String?              @map("buyer_phone")
  buyerNit            String?              @map("buyer_nit")
  buyerCompany        String?              @map("buyer_company")
  paymentMethod       String?              @map("payment_method")
  mpPreferenceId      String?              @map("mp_preference_id")
  mpInitPoint         String?              @map("mp_init_point")
  items               OrderItem[]
  softwareCredentials SoftwareCredential[]

  @@index([status, createdAt], map: "idx_orders_status_created")
  @@map("orders")
}

model OrderItem {
  orderItemId Int      @id @default(autoincrement()) @map("order_item_id")
  orderId     Int      @map("order_id")
  productId   Int?     @map("product_id")
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @default(0) @map("total_price") @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
  product     Product? @relation(fields: [productId], references: [productId], onUpdate: NoAction)

  @@map("order_items")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_password_resets_token")
  @@map("password_resets")
}
