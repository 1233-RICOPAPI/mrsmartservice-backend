generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// NOTE
/// This Prisma schema matches the tables created/updated by `src/schema.ts`.
/// App code uses Prisma typed queries only (no raw SQL).

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("USER")
  createdAt    DateTime @default(now()) @map("created_at")

  productReviews ProductReview[]
  passwordResets PasswordReset[]
  orders         Order[]

  @@map("users")
}

model Product {
  productId       Int       @id @default(autoincrement()) @map("product_id")
  name            String
  description     String?
  techSheet       String?   @map("tech_sheet")
  price           Decimal   @default(0) @db.Decimal(12, 2)
  stock           Int       @default(0)
  discountPercent Int       @default(0) @map("discount_percent")
  category        String?
  imageUrl        String?   @map("image_url")
  videoUrl        String?   @map("video_url")
  active          Boolean   @default(true)
  discountStart   DateTime? @map("discount_start")
  discountEnd     DateTime? @map("discount_end")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  reviews ProductReview[]
  items   OrderItem[]

  @@map("products")
}

model ProductReview {
  reviewId   Int      @id @default(autoincrement()) @map("review_id")
  productId  Int      @map("product_id")
  authorName String   @map("author_name")
  rating     Int      @default(5)
  comment    String?
  userId     Int?     @map("user_id")
  visitorKey String?  @map("visitor_key")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@map("product_reviews")
}

model Ad {
  adId        Int      @id @default(autoincrement()) @map("ad_id")
  title       String
  description String?
  videoUrl    String?  @map("video_url")
  imageUrl    String?  @map("image_url")
  linkUrl     String?  @map("link_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("ads")
}

model Software {
  softwareId              Int      @id @default(autoincrement()) @map("software_id")
  name                    String
  shortDescription        String?  @map("short_description")
  features                String?
  tags                    String? // coma-separado: "Pago único, Offline"
  price                   Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl                String?  @map("image_url")
  whatsappMessageTemplate String?  @map("whatsapp_message_template")
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @map("updated_at")

  licenses    License[]
  credentials SoftwareCredential[]

  @@map("softwares")
}

model SoftwareCredential {
  credentialId Int      @id @default(autoincrement()) @map("credential_id")
  softwareId   Int      @map("software_id")
  orderId      Int?     @map("order_id")
  username     String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  software Software @relation(fields: [softwareId], references: [softwareId], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [orderId], onDelete: SetNull)

  @@unique([softwareId, username])
  @@index([softwareId])
  @@index([orderId])
  @@map("software_credentials")
}

model License {
  licenseId       Int     @id @default(autoincrement()) @map("license_id")
  softwareId      Int     @map("software_id")
  customerEmail   String? @map("customer_email")
  customerName    String? @map("customer_name")
  customerNit     String? @map("customer_nit")
  customerCompany String? @map("customer_company")

  licenseType String    @default("PERPETUAL") @map("license_type")
  majorMax    Int       @default(1) @map("major_max")
  maxSites    Int       @default(3) @map("max_sites")
  maxDevices  Int       @default(6) @map("max_devices")
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  revokedAt   DateTime? @map("revoked_at")
  notes       String?
  licenseKey  String    @map("license_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  software    Software            @relation(fields: [softwareId], references: [softwareId], onDelete: Cascade)
  activations LicenseActivation[]

  @@index([softwareId])
  @@map("licenses")
}

model LicenseActivation {
  activationId  Int       @id @default(autoincrement()) @map("activation_id")
  licenseId     Int       @map("license_id")
  machineId     String    @map("machine_id")
  siteCode      String?   @map("site_code")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  deactivatedAt DateTime? @map("deactivated_at")

  license License @relation(fields: [licenseId], references: [licenseId], onDelete: Cascade)

  @@unique([licenseId, machineId])
  @@index([machineId])
  @@map("license_activations")
}

model Order {
  orderId      Int     @id @default(autoincrement()) @map("order_id")
  userId       Int?    @map("user_id")
  buyerName    String? @map("buyer_name")
  buyerEmail   String? @map("buyer_email")
  buyerPhone   String? @map("buyer_phone")
  buyerNit     String? @map("buyer_nit")
  buyerCompany String? @map("buyer_company")

  status      String  @default("PENDING")
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  paymentMethod String? @map("payment_method")
  paymentId     String? @map("payment_id")
  paymentStatus String? @map("payment_status")

  mpPreferenceId String? @map("mp_preference_id")
  mpInitPoint    String? @map("mp_init_point")
  payerEmail     String? @map("payer_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Domicilio/envío
  domicilioModo      String?   @map("domicilio_modo")
  domicilioNombre    String?   @map("domicilio_nombre")
  domicilioDireccion String?   @map("domicilio_direccion")
  domicilioBarrio    String?   @map("domicilio_barrio")
  domicilioCiudad    String?   @map("domicilio_ciudad")
  domicilioTelefono  String?   @map("domicilio_telefono")
  domicilioNota      String?   @map("domicilio_nota")
  domicilioCosto     Decimal   @default(0) @map("domicilio_costo") @db.Decimal(12, 2)
  fechaDomicilio     DateTime? @map("fecha_domicilio")
  estadoDomicilio    String?   @map("estado_domicilio")

  user                User?                 @relation(fields: [userId], references: [userId], onDelete: SetNull)
  items               OrderItem[]
  softwareCredentials SoftwareCredential[]

  @@map("orders")
}

model OrderItem {
  orderItemId Int     @id @default(autoincrement()) @map("order_item_id")
  orderId     Int     @map("order_id")
  productId   Int     @map("product_id")
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal @default(0) @map("total_price") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId])

  @@map("order_items")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("password_resets")
}
